{% extends "base.html.twig" %}

{% block title %}Screen Recorder - Home{% endblock %}

{% block body %}
    <div class="container-fluid py-5 bg-light">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="display-4 mb-4">
                        <i class="fa-solid fa-camera text-primary"></i> Screen Recorder
                    </h1>
                    <p class="lead text-muted mb-4">
                        Record your screen, create tasks, and organize your recordings all in one place.
                    </p>
                    <div class="d-grid gap-3 d-sm-flex">
                        <a href="{{ path('app_recording') }}" class="btn btn-primary btn-lg">
                            <i class="fas fa-circle-check"></i> Start Recording
                        </a>
                        <a href="{{ path('app_gallery') }}" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-images"></i> View Gallery
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ratio ratio-16x9">
                        <div class="bg-secondary rounded-3 d-flex align-items-center justify-content-center">
                            <div class="text-center text-white">
                                <i class="fa-solid fa-film display-1 mb-3"></i>
                                <p>Your recordings will appear here</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-camera-retro display-4 text-primary mb-3"></i>
                        <h5 class="card-title">Easy Recording</h5>
                        <p class="card-text text-muted">Record your screen with a single click using your browser.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-tasks display-4 text-success mb-3"></i>
                        <h5 class="card-title">Task Management</h5>
                        <p class="card-text text-muted">Create and manage tasks associated with your recordings.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-folder-open display-4 text-info mb-3"></i>
                        <h5 class="card-title">Organized Storage</h5>
                        <p class="card-text text-muted">View and manage all your recordings in one convenient gallery.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center">
            <h2 class="mb-4">Ready to get started?</h2>
            <p class="lead text-muted mb-4">
                Start recording your screen now and keep track of all your videos and tasks.
            </p>
            <a href="{{ path('app_recording') }}" class="btn btn-primary btn-lg">
                <i class="fas fa-circle-play"></i> Start Your First Recording
            </a>
        </div>
    </div>
{% endblock %}
