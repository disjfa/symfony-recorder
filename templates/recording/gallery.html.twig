{% extends "base.html.twig" %}

{% block title %}Gallery - Screen Recorder{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="fa-solid fa-images"></i> Video Gallery
                </h1>
                <a href="{{ path('app_recording') }}" class="btn btn-primary">
                    <i class="fa-solid fa-circle-plus"></i> New Recording
                </a>
            </div>

            {% if videos|length > 0 %}
                <div class="row g-4">
                    {% for video in videos %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="ratio ratio-16x9 bg-dark">
                                    <video
                                        src="{{ video.filePath }}"
                                        controls
                                        style="width: 100%; height: 100%;"
                                    ></video>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">{{ video.title }}</h5>
                                    {% if video.description %}
                                        <p class="card-text text-muted small">{{ video.description|slice(0, 100) }}{% if video.description|length > 100 %}...{% endif %}</p>
                                    {% endif %}
                                    <div class="text-muted small mb-3">
                                        <i class="fa-solid fa-calendar"></i> {{ video.createdAt|date('M d, Y H:i') }}
                                        <br>
                                        <i class="fa-solid fa-file"></i> {{ (video.fileSize / 1024 / 1024)|round(2) }}
                                        MB
                                    </div>
                                    {% if video.task %}
                                        <div class="mb-3">
                                            <span class="badge bg-primary">
                                                <i class="fa-solid fa-circle-check"></i> Task Created
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-footer bg-light">
                                    {% if video.task %}
                                        <div class="btn-group w-100" role="group">
                                            <a
                                                href="{{ path('app_task_show', {id: video.task.id}) }}"
                                                class="btn btn-sm btn-outline-primary"
                                            >
                                                <i class="fa-solid fa-eye"></i> View Task
                                            </a>
                                            <a
                                                href="{{ path('app_task_delete', {id: video.task.id}) }}"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this task and video?');"
                                            >
                                                <i class="fa-solid fa-trash"></i> Delete Task
                                            </a>
                                        </div>
                                    {% else %}
                                        <div class="alert alert-warning mb-0 py-2">
                                            <small><i class="fa-solid fa-circle-exclamation"></i> No task associated</small>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info text-center py-5" role="alert">
                    <i class="fas fa-inbox display-1 mb-3"></i>
                    <h4>No videos yet</h4>
                    <p class="text-muted mb-0">
                        <a href="{{ path('app_recording') }}">Start recording</a> to add your first video!
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
