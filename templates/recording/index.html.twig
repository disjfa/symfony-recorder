{% extends "base.html.twig" %}

{% block title %}Record Screen - Screen Recorder{% endblock %}

{% block body %}
<div class="container-fluid py-4" data-controller="recorder">
    <div class="container">
        <h1 class="mb-4">
            <i class="bi bi-record-circle"></i> Record Your Screen
        </h1>

        <div class="row">
            <!-- Recording Preview -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden" data-recorder-target="preview">
                            <div class="d-flex align-items-center justify-content-center">
                                <div class="text-center text-white">
                                    <i class="bi bi-play-circle display-1 mb-3"></i>
                                    <p>Screen will appear here</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recording Controls -->
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="btn-group w-100" role="group">
                            <button
                                type="button"
                                class="btn btn-lg btn-success"
                                data-action="recorder#startRecording"
                                data-recorder-target="startBtn"
                                id="startBtn"
                            >
                                <i class="bi bi-circle-fill"></i> Start Recording
                            </button>
                            <button
                                type="button"
                                class="btn btn-lg btn-warning"
                                data-action="recorder#pauseRecording"
                                data-recorder-target="pauseBtn"
                                disabled
                                hidden
                            >
                                <i class="bi bi-pause-fill"></i> Pause
                            </button>
                            <button
                                type="button"
                                class="btn btn-lg btn-danger"
                                data-action="recorder#stopRecording"
                                data-recorder-target="stopBtn"
                                disabled
                                hidden
                            >
                                <i class="bi bi-stop-fill"></i> Stop Recording
                            </button>
                        </div>

                        <!-- Timer -->
                        <div class="text-center mt-3" data-recorder-target="timerContainer" hidden>
                            <h3 class="text-muted">
                                <span data-recorder-target="timer">00:00:00</span>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recording Settings -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-sliders"></i> Recording Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Video Title</label>
                            <input
                                type="text"
                                class="form-control"
                                data-recorder-target="videoTitle"
                                placeholder="Enter video title"
                                value="Untitled Recording"
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea
                                class="form-control"
                                rows="3"
                                data-recorder-target="videoDescription"
                                placeholder="Enter video description (optional)"
                            ></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Audio</label>
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="audioCheckbox"
                                    data-recorder-target="audioCheckbox"
                                    checked
                                >
                                <label class="form-check-label" for="audioCheckbox">
                                    Include system audio
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Codec</label>
                            <select class="form-select" data-recorder-target="codecSelect">
                                <option value="vp9">VP9 (Higher Quality)</option>
                                <option value="vp8">VP8 (Standard)</option>
                            </select>
                        </div>

                        <hr>

                        <div class="alert alert-info mb-0" role="alert">
                            <i class="fas fa-info-circle"></i>
                            <strong>Tips:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Choose your screen or window before clicking start</li>
                                <li>Audio and video quality depend on your system</li>
                                <li>Recording stops automatically when you stop the stream</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-cloud-upload"></i> Upload Recording
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden mb-3">
                        <video
                            id="videoPreview"
                            controls
                            data-recorder-target="videoPreview"
                            style="max-width: 100%;"
                        ></video>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Video Title</label>
                        <input
                            type="text"
                            class="form-control"
                            id="uploadTitle"
                            data-recorder-target="uploadTitle"
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea
                            class="form-control"
                            rows="3"
                            id="uploadDescription"
                            data-recorder-target="uploadDescription"
                        ></textarea>
                    </div>

                    <div data-recorder-target="uploadProgress" hidden>
                        <p>Uploading...</p>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-action="recorder#discardVideo"
                        id="discardBtn"
                    >
                        <i class="bi bi-trash"></i> Discard
                    </button>
                    <button
                        type="button"
                        class="btn btn-primary"
                        data-action="recorder#uploadVideo"
                        data-recorder-target="uploadBtn"
                        id="uploadBtn"
                    >
                        <i class="bi bi-upload"></i> Upload & Create Task
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

