{% extends "base.html.twig" %}

{% block title %}Edit Task - Screen Recorder{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h4 class="mb-0">
                                <i class="fa-solid fa-pen"></i> Edit Task
                            </h4>
                        </div>
                        <div class="card-body">
                            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="mb-3">
                                {{ form_label(form.title) }}
                                {{ form_widget(form.title) }}
                                {{ form_errors(form.title) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.status) }}
                                        {{ form_widget(form.status) }}
                                        {{ form_errors(form.status) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.priority) }}
                                        {{ form_widget(form.priority) }}
                                        {{ form_errors(form.priority) }}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.dueDate) }}
                                {{ form_widget(form.dueDate) }}
                                {{ form_errors(form.dueDate) }}
                            </div>

                            {% if task.video %}
                                <div class="alert alert-info" role="alert">
                                    <i class="fas fa-info-circle"></i>
                                    <strong>Associated Video:</strong> {{ task.video.title }}
                                </div>
                            {% endif %}

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="{{ path('app_task_show', {id: task.id}) }}" class="btn btn-secondary">
                                    <i class="fa-solid fa-circle-xmark"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-circle-check"></i> Save Changes
                                </button>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm sticky-top" style="top: 20px;">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Task Info</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-6">Created:</dt>
                                <dd class="col-sm-6">{{ task.createdAt|date('M d, Y') }}</dd>

                                <dt class="col-sm-6">Last Updated:</dt>
                                <dd class="col-sm-6">{{ task.updatedAt|date('M d, Y') }}</dd>

                                <dt class="col-sm-6">Current Status:</dt>
                                <dd class="col-sm-6">
                                    <span class="badge bg-{{ task.status == 'completed' ? 'success' : (task.status == 'in_progress' ? 'info' : (task.status == 'pending' ? 'warning' : 'secondary')) }}">
                                        {{ task.status|replace({'_': ' '})|title }}
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
