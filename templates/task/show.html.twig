{% extends "base.html.twig" %}

{% block title %}{{ task.title }} - Screen Recorder{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">{{ task.title }}</h4>
                            <span class="badge bg-{{ task.status == 'completed' ? 'success' : (task.status == 'in_progress' ? 'info' : (task.status == 'pending' ? 'warning' : 'secondary')) }} fs-6">
                                {{ task.status|replace({'_': ' '})|title }}
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        {% if task.description %}
                            <h6 class="text-muted">Description</h6>
                            <p>{{ task.description }}</p>
                            <hr>
                        {% endif %}

                        <h6 class="text-muted">Priority</h6>
                        <div class="mb-3">
                            {% if task.priority == 'high' %}
                                <span class="badge bg-danger fs-6">
                                    <i class="bi bi-exclamation-triangle-fill"></i> High Priority
                                </span>
                            {% elseif task.priority == 'medium' %}
                                <span class="badge bg-warning fs-6">
                                    <i class="bi bi-dash-circle"></i> Medium Priority
                                </span>
                            {% else %}
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-circle"></i> Low Priority
                                </span>
                            {% endif %}
                        </div>

                        <hr>

                        <h6 class="text-muted">Dates</h6>
                        <ul class="list-unstyled">
                            <li>
                                <i class="bi bi-calendar-event"></i>
                                <strong>Created:</strong> {{ task.createdAt|date('F j, Y \a\t g:i a') }}
                            </li>
                            {% if task.dueDate %}
                                <li>
                                    <i class="bi bi-calendar-check"></i>
                                    <strong>Due:</strong> {{ task.dueDate|date('F j, Y \a\t g:i a') }}
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>

                {% if task.video %}
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-film"></i> Associated Video
                            </h5>
                        </div>
                        <div class="card-body">
                            <h6 class="text-muted">{{ task.video.title }}</h6>
                            <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden mb-3">
                                <video src="{{ task.video.filePath }}" controls style="width: 100%;"></video>
                            </div>
                            {% if task.video.description %}
                                <p class="text-muted">{{ task.video.description }}</p>
                            {% endif %}
                            <div class="text-muted small">
                                <i class="bi bi-clock"></i> {{ task.video.createdAt|date('F j, Y \a\t g:i a') }}
                                <br>
                                <i class="bi bi-file-earmark"></i> {{ (task.video.fileSize / 1024 / 1024)|round(2) }} MB
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Actions</h5>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <a href="{{ path('app_task_edit', {id: task.id}) }}" class="btn btn-primary">
                            <i class="fas fa-pencil"></i> Edit Task
                        </a>
                        <a href="{{ path('app_tasks') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Tasks
                        </a>
                        <button
                            type="button"
                            class="btn btn-danger"
                            onclick="if(confirm('Are you sure you want to delete this task?')) { fetch('{{ path('app_task_delete', {id: task.id}) }}', {method: 'POST'}).then(() => location.href = '{{ path('app_tasks') }}'); }"
                        >
                            <i class="fas fa-trash"></i> Delete Task
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

