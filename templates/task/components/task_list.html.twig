{% if tasks|length > 0 %}
    <div class="row g-3">
        {% for task in tasks %}
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">{{ task.title }}</h5>
                            <span class="badge bg-{{ task.status == 'completed' ? 'success' : (task.status == 'in_progress' ? 'info' : (task.status == 'pending' ? 'warning' : 'secondary')) }}">
                                {{ task.status|replace({'_': ' '})|title }}
                            </span>
                        </div>

                        {% if task.description %}
                            <p class="card-text text-muted small mb-3">{{ task.description|slice(0, 150) }}{% if task.description|length > 150 %}...{% endif %}</p>
                        {% endif %}

                        <div class="mb-3">
                            {% if task.priority == 'high' %}
                                <span class="badge bg-danger">
                                    <i class="fa-solid fa-triangle-exclamation"></i> High Priority
                                </span>
                            {% elseif task.priority == 'medium' %}
                                <span class="badge bg-warning">
                                    <i class="fa-solid fa-minus-circle"></i> Medium Priority
                                </span>
                            {% else %}
                                <span class="badge bg-success">
                                    <i class="fa-solid fa-circle-check"></i> Low Priority
                                </span>
                            {% endif %}
                        </div>

                        {% if task.dueDate %}
                            <div class="text-muted small mb-3">
                                <i class="fas fa-calendar"></i> Due: {{ task.dueDate|date('M d, Y') }}
                            </div>
                        {% endif %}

                        {% if task.video %}
                            <div class="bg-light p-2 rounded mb-3">
                                <i class="fas fa-video"></i>
                                <strong>Video:</strong> {{ task.video.title }}
                                <br>
                                <small class="text-muted">{{ task.video.createdAt|date('M d, Y H:i') }}</small>
                            </div>
                        {% endif %}

                        <div class="text-muted small">
                            <i class="fas fa-clock"></i> Created: {{ task.createdAt|date('M d, Y H:i') }}
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <div class="btn-group w-100" role="group">
                            <a href="{{ path('app_task_show', {id: task.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye"></i> View
                            </a>
                            <a href="{{ path('app_task_edit', {id: task.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-pencil"></i> Edit
                            </a>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger"
                                onclick="if(confirm('Are you sure you want to delete this task and its video?')) { window.location.href = '{{ path('app_task_delete', {id: task.id}) }}'; }"
                            >
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="alert alert-info text-center py-5" role="alert">
        <i class="fas fa-inbox display-1 mb-3"></i>
        <h4>No tasks yet</h4>
        <p class="text-muted mb-0">
            <a href="{{ path('app_recording') }}">Record your first video</a> to create a task!
        </p>
    </div>
{% endif %}
